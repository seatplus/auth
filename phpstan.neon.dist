includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/phpstan/phpstan-mockery/extension.neon
    - vendor/pestphp/pest-plugin-phpstan/extension.neon

parameters:
    editorUrl: 'phpstorm://open?file=%%file%%&line=%%line%%'
    databaseMigrationsPath:
        - database/migrations
        - vendor/seatplus/eveapi/database/migrations
    level: 4
    paths:
        - src
        - database
        - tests
    tmpDir: build/phpstan
    checkOctaneCompatibility: true
    checkModelProperties: true

    # Test bodies and hooks use `$this`, which pest-plugin-phpstan types as the real
    # TestCase. The bare `test()` accessor is still needed in dataset closures and in
    # the global helpers in tests/Pest.php, where `$this` is not bound — and there the
    # return type stays `TestCall|HigherOrderTapProxy`, so treat those as property bags.
    universalObjectCratesClasses:
        - Pest\PendingCalls\TestCall
        - Pest\Support\HigherOrderTapProxy

    ignoreErrors:
        # Cache::spy() turns the facade into a Mockery spy, but larastan only models the
        # facade's real accessor class, so the spy assertion API is invisible to it.
        -
            identifier: staticMethod.notFound
            message: '#^Call to an undefined static method Illuminate\\Support\\Facades\\[A-Za-z]+::shouldHaveReceived\(\)\.$#'
            path: tests

        # Deliberate: the guard has to read the raw env, because the whole point is to
        # catch the case where the phpunit DB_DATABASE override did not hold.
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            path: tests/TestCase.php
