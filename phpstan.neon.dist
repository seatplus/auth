includes:
    - vendor/larastan/larastan/extension.neon
    # Pest-aware static analysis (understands it()/expect()/$this).
    - vendor/pestphp/pest-plugin-phpstan/extension.neon
    # Understands Mockery's dynamic API (shouldReceive(), etc.).
    - vendor/phpstan/phpstan-mockery/extension.neon

parameters:
    editorUrl: 'phpstorm://open?file=%%file%%&line=%%line%%'
    databaseMigrationsPath:
        - database/migrations
        - vendor/seatplus/eveapi/database/migrations
    level: 4
    paths:
        - src
        - database
        - tests
    tmpDir: build/phpstan
    checkOctaneCompatibility: true
    checkModelProperties: true
    ignoreErrors:
        # Style rule; pest.expectation.impossible (real bugs) stays active.
        -
            identifier: pest.expectation.redundant
        # Pest higher-order proxy: dynamic test-state props (test()->x / $this->x set
        # in setUp/helpers) are not statically declared on the proxy type.
        -
            message: '#Access to an undefined property Pest\\(PendingCalls\\TestCall|Support\\HigherOrderTapProxy).*::\$#'
        # Mockery's dynamic API (partial-mock methods/props on a bare MockInterface).
        -
            message: '#(Call to an undefined method|Access to an undefined property) Mockery\\(Legacy)?MockInterface::#'
        # Pest higher-order expectation chaining (expect()->x, ->and()->y, etc.).
        -
            message: '#Call to an undefined method Pest\\(Expectation|Expectations\\HigherOrderExpectation|PendingCalls\\TestCall)#'
        # Mockery facade spies/expectations (Cache::shouldReceive()/spy()).
        -
            message: '#Call to an undefined static method Illuminate\\Support\\Facades\\Cache::#'
        # Dataset-driven test matches are exhaustive for their declared datasets;
        # src matches are unaffected (none currently trip this).
        -
            message: '#Match expression does not handle remaining value#'
        # Intentional env() call: the setUp() dev-DB safety guard.
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            path: tests/TestCase.php
        # Socialite's AbstractUser::$attributes assignment in a test helper.
        -
            message: '#Property Laravel\\Socialite\\AbstractUser::\$attributes#'
        # Assorted pre-existing test-shape quirks (orphaned/misplaced constructs).
        -
            identifier: larastan.noUnnecessaryCollectionCall
        -
            message: '#Calling parent::setUp\(\) outside of class scope#'
        -
            identifier: pest.describe.withoutTests
        -
            message: '#Undefined variable: \$this#'
            path: tests/Feature/Middleware/CheckAuthorizationTest.php
        # Value is null via a nullable return; the runtime path returns a model.
        -
            identifier: pest.expectation.impossible
            path: tests/Unit/UpdateRefreshTokenActionTest.php
        # Base-class-typed vars miss subclass/trait members: seatplus Role adds
        # $type (RoleType), seatplus User has Spatie's HasRoles (hasPermissionTo()),
        # RedirectResponse adds getTargetUrl() — the runtime objects are the subtypes.
        -
            message: '#(Access to an undefined property Spatie\\Permission\\(Models|Contracts)\\Role::\$type|Call to an undefined method Illuminate\\Foundation\\Auth\\User::hasPermissionTo\(\)|Call to an undefined method Symfony\\Component\\HttpFoundation\\Response::getTargetUrl\(\))#'
        # Pest describe() higher-order chaining (->only()).
        -
            message: '#Call to an undefined method Pest\\PendingCalls\\DescribeCall::#'


